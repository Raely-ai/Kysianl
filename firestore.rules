rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.email == "admin@kayserianlik.com" || request.auth.token.email == "hpferdicakir@gmail.com");
    }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /news/{newsId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /homepageBlocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /homepageLayouts/{layoutId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteLayouts/{layoutId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customBlocks/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menuItems/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}

