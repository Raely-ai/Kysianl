rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitive Definition
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // We will consider the user to be admin if they are registered in the userRoles collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }
    
    // Validation Blueprints
    function isValidNews(data) {
      return data.keys().hasAll(['title', 'slug', 'summary', 'category', 'status', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 && data.title.size() > 0 &&
             data.slug is string && data.slug.size() <= 200 && data.slug.size() > 0 &&
             data.summary is string && data.summary.size() <= 500 &&
             data.category is string && data.category.size() <= 50 &&
             data.status is string && data.status in ['draft', 'published'] &&
             data.createdAt is number &&
             (data.keys().hasAny(['content']) ? data.content is string : true) &&
             (data.keys().hasAny(['imageUrl']) ? data.imageUrl is string : true) &&
             (data.keys().hasAny(['isBreaking']) ? data.isBreaking is bool : true) &&
             (data.keys().hasAny(['updatedAt']) ? data.updatedAt is number : true) &&
             (data.keys().hasAny(['authorId']) ? data.authorId is string : true);
    }
    
    // Match News
    match /news/{newsId} {
      // Anyone can read published news, but only admins can list all (including drafts)
      allow get: if (existing().status == 'published') || isAdmin();
      allow list: if (existing().status == 'published') || isAdmin();
      
      allow create: if isSignedIn() && isAdmin() && isValidId(newsId) && isValidNews(incoming());
      
      allow update: if isSignedIn() && isAdmin() && isValidNews(incoming());
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Match User Roles
    match /userRoles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId || isAdmin();
      allow write: if false; // Only manageable through manual database intervention or separated admin app
    }
  }
}
